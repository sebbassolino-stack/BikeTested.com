{
  "name": "bike-tested",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/validate.mjs && astro build && pagefind --site dist && node scripts/check-build.mjs && node scripts/check-offers.mjs && node scripts/check-search-contract.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "check": "node scripts/validate.mjs",
    "review:queue": "node scripts/review-queue.mjs"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
