---
import {offerFor} from '../data/catalog';
import ProductPrice from './ProductPrice.astro';
import {priceState} from '../lib/pricing';
const {product:p,featured=false}=Astro.props;const offer=offerFor(p);const price=priceState(p,offer);const codeSavingConfirmed=['observed','estimated'].includes(price.kind);const exactVariantEligible=p.eligibility?.status==='eligible'&&p.eligibility.variantId===p.price?.variantId;
---
<article class:list={['product-card',{featured}]} data-product={p.slug} data-category={p.category} data-use={p.use} data-search={`${p.name} ${p.label} ${p.brand} ${p.category}`.toLowerCase()}><a class="product-image" href={`/reviews/${p.slug}`}><img src={p.image} width={p.imageWidth||1200} height={p.imageHeight||800} alt={p.imageAlt||p.name} loading="lazy"/><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-body"><span class="kicker">{p.label}</span><h3><a href={`/reviews/${p.slug}`}>{p.name}: {p.headline.charAt(0).toLowerCase()+p.headline.slice(1)}</a></h3><p>{p.description}</p><ProductPrice product={p} offer={offer} compact={true}/>{offer?.code&&<a class="note" href={`/promo/${p.brand}`}>Code {offer.code}{codeSavingConfirmed&&offer.benefit?`: ${offer.benefit}`:exactVariantEligible?' · check sale terms at checkout':' · check variant eligibility'} · terms →</a>}<a class="text-link" href={`/reviews/${p.slug}`}>Read the review <span>→</span></a></div></article>
