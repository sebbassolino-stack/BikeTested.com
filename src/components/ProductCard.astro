---
import {offerFor} from '../data/catalog';
const {product:p,featured=false}=Astro.props;const offer=offerFor(p);
---
<article class:list={['product-card',{featured}]} data-use={p.use} data-search={`${p.name} ${p.label}`.toLowerCase()}><a class="product-image" href={`/reviews/${p.slug}`}><img src={p.image} width="1200" height="800" alt={p.name} loading="lazy"/><span class="image-arrow" aria-hidden="true">↗</span></a><div class="card-body"><span class="kicker">{p.label}</span><h3><a href={`/reviews/${p.slug}`}>{p.name}: {p.headline.charAt(0).toLowerCase()+p.headline.slice(1)}</a></h3><p>{p.description}</p>{offer?.code&&<a class="note" href={`/promo/${p.brand}`}>Code {offer.code}{offer.benefit?`: ${offer.benefit}`:''} →</a>}<a class="text-link" href={`/reviews/${p.slug}`}>Read the review <span>→</span></a></div></article>
