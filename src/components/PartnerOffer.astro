---
import {offerLabel} from '../lib/offers';
const {offer:o,name,placement='promo'}=Astro.props;
---
<div class="partner-offer">
  <span class="kicker">Bike Tested × {name}</span><h2>{offerLabel(o)}</h2>
  {o.code&&<div class="code-row"><code>{o.code}</code><button class="code-button" data-copy-code={o.code} data-brand={o.brand} data-placement={placement} aria-label={`Copy ${name} code ${o.code}`} aria-live="polite">Copy code</button></div>}
  <a class="button lime" href={o.url} target="_blank" rel="sponsored noopener" data-outbound data-affiliate="true" data-brand={o.brand} data-placement={placement}>Shop {name} ↗</a>
  <p class="disclosure">We may earn a commission when you buy through this link.</p>
  <p class="note">{o.code?'Partner code supplied':'Partner link supplied'} <time datetime={o.reportedOn}>{o.reportedOn}</time>. {o.checkoutTestProduct?`Code acceptance${o.checkoutTestProduct.stage==='cart'?' in the cart':''} recorded ${o.checkoutTestedOn} for ${o.checkoutTestProduct.name}, ${o.checkoutTestProduct.variantLabel} only.`:o.codeCheckProduct?o.codeCheckProduct.result==='invalid-code'?`Checkout rejected ${o.code} as invalid on ${o.checkoutTestedOn} for ${o.codeCheckProduct.name}, ${o.codeCheckProduct.variantLabel}; no saving is confirmed.`:`A ${o.codeCheckProduct.stage} check on ${o.checkoutTestedOn} for ${o.codeCheckProduct.name}, ${o.codeCheckProduct.variantLabel} showed ${o.codeCheckProduct.discountFormatted} off; no saving is confirmed.`:'No exact-product code acceptance observation is recorded.'}</p>
  {o.regionNote&&<p class="note">{o.regionNote}</p>}{o.storeNotice&&<p class="store-notice">{o.storeNotice}</p>}
</div>
