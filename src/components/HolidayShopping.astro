---
interface Props {kind: 'gifts' | 'deals'; config: {name:string; domain:string; topic:string; gifts:string[][]}; offers: {brand:string;code?:string|null;benefit?:string|null;url:string;path:string}[]}
const {kind,config,offers}=Astro.props;
const gift=kind==='gifts';
const faqs=gift?[
['What makes a useful '+config.topic+' gift?','Start with the recipient’s current setup, preferences and the item they actually need. Check size, compatibility, care and return conditions before ordering.'],
['Are Christmas delivery dates guaranteed?','No delivery deadline is listed here. Use the merchant’s delivery estimate for the exact item and destination; preorder and personalized items can have different lead times.'],
['Can I use a partner code on a gift?','Use the brand’s offer page for its supplied code and benefit. Product exclusions, sale combinations and gift-card eligibility depend on the store’s terms.']
]:[
['When are Black Friday and Cyber Monday in 2026?','Black Friday is Friday, November 27, 2026. Cyber Monday is Monday, November 30, 2026. This page covers both shopping dates.'],
['Are these Black Friday-only discount codes?','These are the partner offers recorded by '+config.name+'. They are a starting point for comparing prices; they are not announced Black Friday or Cyber Monday sales.'],
['Can I combine a code with a Black Friday sale?','Use a combination only when the store permits it. Compare the final sale total with the total after the code and choose the better eligible offer. Stacking is not assumed.'],
['Will these codes work throughout the holiday sale?','The listed codes and benefits reflect the supplied partner records. Future holiday validity and product eligibility have not been supplied for every offer; use the brand page and the store’s terms for your order.']
];
const title=gift?`${config.name} Holiday Gift Guide 2026: ${config.topic} Gifts`:`Black Friday & Cyber Monday ${config.topic} Deals 2026 | ${config.name}`;
const description=gift?`Choose thoughtful ${config.topic.toLowerCase()} gifts with recipient-fit guidance, useful buying guides and ${config.name} partner codes.`:`Compare ${config.name} partner codes before Black Friday November 27 and Cyber Monday November 30, 2026. Current benefits, store links and sale-comparison advice.`;
const schema=[{'@type':'WebPage',name:title,description,url:'https://'+config.domain+(gift?'/holiday-gift-guide':'/black-friday-deals'),datePublished:'2026-10-29',dateModified:'2026-10-29'}, {'@type':'FAQPage',mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))}];
---
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@graph":schema})}/>
<article class="holiday"><nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/deals">Partner offers</a> / {gift?'Holiday gift guide':'Black Friday & Cyber Monday'}</nav><header><p class="edition">Holiday shopping / 2026</p><h1>{gift?config.topic+' gifts, chosen with care.':'Black Friday & Cyber Monday '+config.topic.toLowerCase()+' deals.'}</h1><p class="lead">{gift?'Choose a gift around the person, their routine and what they already own. These are our starting points for a useful gift, with guides to help you narrow the choice.':'Black Friday falls on November 27 and Cyber Monday on November 30, 2026. Start with the partner codes below, then compare the store’s holiday sale and the final total before choosing an offer.'}</p><p class="date">Published October 29, 2026 · Offer dates remain recorded on each brand page.</p></header><p class="disclosure">We may earn a commission from qualifying purchases through partner links, at no extra cost to you.</p>
{gift?<><section class="gift-grid">{config.gifts.map(([label,heading,text,guide])=><section class="gift"><p class="edition">{label}</p><h2>{heading}</h2><p>{text}</p><a href={'/guides/'+guide}>Read our buying guide →</a></section>)}</section><section><h2>Choose the budget after the fit</h2><p>For a small gift, focus on an accessory or a familiar favorite. For a larger purchase, agree on the exact model, size or configuration with the recipient first. Compare the complete order cost, including any required accessories, shipping and recurring charges.</p><h2>Check returns and delivery before ordering</h2><p>Read the store’s gift-return conditions, especially for opened personal-care items, customized products and digital purchases. Check the delivery estimate for your exact destination; no generic Christmas shipping cutoff applies to every partner.</p><a href="/black-friday-deals">Compare Black Friday and Cyber Monday partner offers →</a></section></>:<><section class="notice"><h2>Current codes to compare with holiday sales</h2><p>This directory uses the site’s partner records. A listed code is not a holiday-sale announcement, a guarantee of future availability or a claim that it combines with another promotion.</p></section><div class="table-wrap" role="region" aria-label="Partner codes" tabindex="0"><table><caption>Partner codes and supplied benefits</caption><thead><tr><th scope="col">Brand</th><th scope="col">Code</th><th scope="col">Supplied benefit</th><th scope="col">Details and store</th></tr></thead><tbody>{offers.filter(o=>o.code).map(o=><tr><th scope="row">{o.brand}</th><td><code>{o.code}</code> <button type="button" data-holiday-code={o.code} aria-label={'Copy '+o.brand+' code'}>Copy</button></td><td>{o.benefit||'Amount not supplied'}</td><td><a href={o.path}>Code & terms</a><br/><a href={o.url} target="_blank" rel="sponsored noopener noreferrer" data-affiliate="true" data-brand={o.brand} data-placement="holiday">Shop {o.brand} ↗</a></td></tr>)}</tbody></table></div><section><h2>Compare the price you will actually pay</h2><ol><li>Choose the exact product, size and regional store.</li><li>Compare the store’s sale price with the price after the eligible code. A larger percentage does not always produce a lower total.</li><li>Check shipping, tax, required extras and any subscription terms before paying.</li></ol><p>Use the brand’s code page for the recorded offer and relevant product coverage. We add brand-specific holiday sales when their dates and terms are available.</p><h2>Buying a gift?</h2><p>Choose for the recipient’s preferences and existing equipment before choosing a discount.</p><a href="/holiday-gift-guide">Explore our holiday gift guide →</a></section></>}
<section><h2>Shopping questions</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><nav class="closing"><a href="/deals">All partner offers</a><a href="/guides">Buying guides</a><a href="/reviews">Product reviews</a></nav></article>
<script>document.querySelectorAll<HTMLButtonElement>('[data-holiday-code]').forEach(button=>button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(button.dataset.holidayCode||'');button.textContent='Copied';setTimeout(()=>{button.textContent='Copy'},2000)}catch{button.textContent='Select code above'}}));</script>
<style>.holiday{max-width:1120px;margin:0 auto;padding:40px 24px 72px;line-height:1.65}.holiday header{max-width:820px;padding:34px 0 20px}.holiday h1{font-size:clamp(2.2rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}.holiday h2{font-size:1.65rem;line-height:1.22;margin:0 0 16px}.holiday .lead{font-size:1.2rem;margin-top:24px}.holiday .edition,.holiday .date,.holiday .disclosure{font-size:.85rem}.holiday .edition{text-transform:uppercase;letter-spacing:.12em}.holiday section{margin:36px 0}.holiday .notice,.holiday .gift{padding:24px;border:1px solid currentColor;border-radius:12px}.holiday .gift-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.holiday .gift{margin:0}.holiday a{text-decoration:underline;text-underline-offset:.2em}.holiday .table-wrap{max-width:100%;overflow-x:auto;margin:32px 0;border:1px solid currentColor;border-radius:8px}.holiday table{border-collapse:collapse;width:100%;font-size:.95rem}.holiday th,.holiday td{padding:18px;text-align:left;border-bottom:1px solid currentColor;vertical-align:top}.holiday code{overflow-wrap:anywhere}.holiday button{display:block;padding:6px 12px;margin-top:8px;border:1px solid currentColor;border-radius:4px;background:transparent;color:inherit;cursor:pointer;font:inherit}.holiday details{padding:16px 0;border-bottom:1px solid currentColor}.holiday summary{cursor:pointer;font-weight:600}.holiday .closing{display:flex;gap:24px;flex-wrap:wrap;margin-top:40px}@media(max-width:650px){.holiday{padding:24px 18px 48px}.holiday .gift-grid{grid-template-columns:1fr}.holiday th,.holiday td{padding:12px}.holiday .table-wrap table{min-width:590px}}</style>
