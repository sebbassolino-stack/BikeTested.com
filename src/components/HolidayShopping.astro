---
import HolidayProductPicks from "./HolidayProductPicks.astro";
interface Props {kind: 'gifts' | 'deals'; config: {name:string; domain:string; topic:string; gifts:string[][];guideBase?:string;guideHub?:string;reviewHub?:string;trailingSlash?:boolean;sitemapPath?:string}; offers: {brand:string;code?:string|null;benefit?:string|null;url:string;path:string;expiresOn?:string|null}[]}
const {kind,config,offers}=Astro.props;
const gift=kind==='gifts';
const edition=new Date().toLocaleDateString('en-US',{month:'long',year:'numeric',timeZone:'UTC'});
const REDIRECT_HOSTS=['refr.cc','sjv.io','awin1.com','linksynergy.com','amzn.to','impact.com','shareasale.com','pntra.com','pntrs.com','tkqlhce.com','go.skimresources.com'];
const storeLabel=(url: string, brand: string)=>{try{const host=new URL(url).hostname.replace(/^www\./,'').toLowerCase();return REDIRECT_HOSTS.some(h=>host===h||host.endsWith('.'+h))?`the ${brand} store`:host;}catch{return `the ${brand} store`;}};
const statedBenefit=(benefit: string | null | undefined)=>{const d=(benefit??'').trim();if(!d||/not stated|not recorded|not listed|shown at checkout|amount not|unknown/i.test(d)||!/\d/.test(d))return '';return d;};
const coded=offers.filter(o=>o.code);
const codeSentence=(o: {brand:string;code?:string|null;benefit?:string|null;url:string})=>`The ${o.brand} discount code is ${o.code}${statedBenefit(o.benefit)?` for ${statedBenefit(o.benefit)}`:''} at ${storeLabel(o.url,o.brand)}.`;
const codeAnswer=coded.length?coded.map(codeSentence).join(' ')+` All are ${config.name} partner codes, active ${edition}.`:'';
const codeQuestion=`What are the current ${config.topic.toLowerCase()} discount codes?`;
const faqs=gift?[
...(codeAnswer?[[codeQuestion,codeAnswer]]:[]),
['What makes a useful '+config.topic+' gift?','Start with the recipient’s current setup, preferences and the item they actually need. Check size, compatibility, care and return conditions before ordering.'],
['Are Christmas delivery dates guaranteed?','No delivery deadline is listed here. Use the merchant’s delivery estimate for the exact item and destination; preorder and personalized items can have different lead times.'],
['Can I use a partner code on a gift?','Use the brand’s offer page for its supplied code and benefit. Product exclusions, sale combinations and gift-card eligibility depend on the store’s terms.']
]:[
...(codeAnswer?[[codeQuestion,codeAnswer]]:[]),
['When are Black Friday and Cyber Monday in 2026?','Black Friday is Friday, November 27, 2026. Cyber Monday is Monday, November 30, 2026. This page covers both shopping dates.'],
['Are these Black Friday-only discount codes?','These are the partner offers recorded by '+config.name+'. They are a starting point for comparing prices; they are not announced Black Friday or Cyber Monday sales.'],
['Can I combine a code with a Black Friday sale?','Use a combination only when the store permits it. Compare the final sale total with the total after the code and choose the better eligible offer. Stacking is not assumed.'],
['Will these codes work throughout the holiday sale?','The listed codes and benefits reflect the supplied partner records. Holiday dates and eligible products vary by offer; use the brand page and the store’s terms for your order.']
];
const title=gift?`${config.name} Holiday Gift Guide (${edition}): ${config.topic} Gifts`:`Black Friday & Cyber Monday ${config.topic} Deals (${edition}) | ${config.name}`;
const description=gift?`Choose thoughtful ${config.topic.toLowerCase()} gifts with recipient-fit guidance, useful buying guides and ${config.name} partner codes.`:`Compare ${config.name} partner codes before Black Friday November 27 and Cyber Monday November 30, 2026. Current benefits, store links and sale-comparison advice.`;
const schema=[{'@type':'WebPage',name:title,description,url:'https://'+config.domain+(gift?'/holiday-gift-guide':'/black-friday-deals'),datePublished:'2026-10-29',dateModified:'2026-11-01'}, {'@type':'FAQPage',mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))}];
---
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@graph":schema})}/>
<article class="holiday"><nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/deals">Partner offers</a> / {gift?'Holiday gift guide':'Black Friday & Cyber Monday'}</nav><header><p class="edition">Holiday shopping / {edition}</p><h1>{gift?config.topic+' gifts, chosen with care.':'Black Friday and Cyber Monday '+config.topic.toLowerCase()+' deals ('+edition+').'}</h1><p class="lead">{gift?'Choose a gift around the person, their routine and what they already own. The partner codes below are the same offers as the deals list, and they are not announced holiday sales.':'Black Friday is November 27 and Cyber Monday is November 30, 2026. The partner codes below match the deals list. Compare each code with the store’s own sale and the final total. These are not announced holiday sales.'}</p><p class="date">Published October 29, 2026 · Offer dates remain recorded on each brand page.</p></header><p class="disclosure">We may earn a commission from qualifying purchases through partner links, at no extra cost to you.</p>
{coded.length>0&&<section class="codes-first" id="codes"><h2>Current partner codes, {edition}</h2><ul class="code-cards">{coded.map(o=><li><p class="code-brand"><a href={o.path}>{o.brand}</a></p><p class="code-saving">{statedBenefit(o.benefit)||'Shown at checkout'}</p><code>{o.code}</code><button type="button" data-holiday-code={o.code} data-brand={o.brand} data-placement="holiday-code-card" aria-label={'Copy '+o.brand+' code'}>Copy</button><a class="code-shop" href={o.url} target="_blank" rel="sponsored noopener noreferrer" data-commerce-shop data-brand={o.brand} data-placement="holiday">Shop {o.brand}</a></li>)}</ul><details class="code-answers-fold"><summary>Read each code as a full sentence</summary><ul class="code-answers">{coded.map(o=><li>{codeSentence(o)} <a href={o.path}>Code and terms</a></li>)}</ul></details></section>}
{gift?<><HolidayProductPicks offers={offers} domain={config.domain}/><section class="gift-grid">{config.gifts.map(([label,heading,text,guide])=><section class="gift"><p class="edition">{label}</p><h2>{heading}</h2><p>{text}</p><a href={'/guides/'+guide}>Read our buying guide →</a></section>)}</section><section><h2>Choose the budget after the fit</h2><p>For a small gift, focus on an accessory or a familiar favorite. For a larger purchase, agree on the exact model, size or configuration with the recipient first. Compare the complete order cost, including any required accessories, shipping and recurring charges.</p><h2>Check returns and delivery before ordering</h2><p>Read the store’s gift-return conditions, especially for opened personal-care items, customized products and digital purchases. Check the delivery estimate for your exact destination; no generic Christmas shipping cutoff applies to every partner.</p><a href="/black-friday-deals">Compare Black Friday and Cyber Monday partner offers →</a></section></>:<><section><h2>Compare the price you will actually pay</h2><ol><li>Choose the exact product, size and regional store.</li><li>Compare the store’s sale price with the price after the eligible code. A larger percentage does not always produce a lower total.</li><li>Check shipping, tax, required extras and any subscription terms before paying.</li></ol><p>Use the brand’s code page for the recorded offer and relevant product coverage. We add brand-specific holiday sales when their dates and terms are available.</p><h2>Buying a gift?</h2><p>Choose for the recipient’s preferences and existing equipment before choosing a discount.</p><a href="/holiday-gift-guide">Explore our holiday gift guide →</a></section></>}
<section><h2>Shopping questions</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><nav class="closing"><a href="/deals">All partner offers</a><a href="/guides">Buying guides</a><a href={config.reviewHub||'/reviews'}>Product reviews</a></nav></article>
<script>import "../scripts/holiday-commerce";</script>
<style>.holiday{max-width:1120px;margin:0 auto;padding:40px 24px 72px;line-height:1.65}.holiday header{max-width:820px;padding:34px 0 20px}.holiday h1{font-size:clamp(2.2rem,5vw,4rem);line-height:1.08;letter-spacing:-.035em}.holiday h2{font-size:1.65rem;line-height:1.22;margin:0 0 16px}.holiday .lead{font-size:1.2rem;margin-top:24px}.holiday .edition,.holiday .date,.holiday .disclosure{font-size:.85rem}.holiday .edition{text-transform:uppercase;letter-spacing:.12em}.holiday section{margin:36px 0}.holiday .notice,.holiday .gift{padding:24px;border:1px solid currentColor;border-radius:12px}.holiday .gift-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.holiday .gift{margin:0}.holiday a{text-decoration:underline;text-underline-offset:.2em}.holiday .table-wrap{max-width:100%;overflow-x:auto;margin:32px 0;border:1px solid currentColor;border-radius:8px}.holiday table{border-collapse:collapse;width:100%;font-size:.95rem}.holiday th,.holiday td{padding:18px;text-align:left;border-bottom:1px solid currentColor;vertical-align:top}.holiday .known-expiry{display:block;margin-top:8px}.holiday code{overflow-wrap:anywhere}.holiday button{display:block;padding:6px 12px;margin-top:8px;border:1px solid currentColor;border-radius:4px;background:transparent;color:inherit;cursor:pointer;font:inherit}.holiday details{padding:16px 0;border-bottom:1px solid currentColor}.holiday summary{cursor:pointer;font-weight:600}.holiday .closing{display:flex;gap:24px;flex-wrap:wrap;margin-top:40px}@media(max-width:650px){.holiday{padding:24px 18px 48px}.holiday .gift-grid{grid-template-columns:1fr}.holiday th,.holiday td{padding:12px}.holiday .table-wrap table{min-width:590px}}.holiday .code-answers{padding-left:1.2em}.holiday .code-answers li{margin:0 0 12px}.holiday .code-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;list-style:none;padding:0;margin:16px 0 0}.holiday .code-cards li{border:1px solid currentColor;border-radius:8px;padding:14px;display:flex;flex-direction:column;align-items:flex-start;gap:8px}.holiday .code-cards p{margin:0}.holiday .code-brand{font-weight:700}.holiday .code-saving,.holiday .code-shop,.holiday .code-cards button,.holiday .code-cards code{font-size:13px}.holiday .code-cards button{display:inline-block;width:auto;margin:0}.holiday .code-answers-fold{margin-top:20px}</style>
