---
import {brandFor,offerFor} from '../data/catalog';
import {productOfferAnswer} from '../lib/offers';
import ProductPrice from './ProductPrice.astro';
const {product:p,placement='review',compact=false}=Astro.props;const brand=brandFor(p);const offer=offerFor(p);
---
{compact?<div class="buybox buybox-compact"><span class="kicker">Check the current listing</span><h3>{p.name}</h3><a class="button blue" href={offer?.url||p.source} target="_blank" rel={offer?'sponsored noopener':'noopener'} data-outbound data-affiliate={offer?'true':'false'} data-brand={brand.slug} data-product={p.slug} data-placement={placement}>Price & availability at {brand.name} <span>↗</span></a>{offer?.code&&<a class="text-link" href={`/promo/${brand.slug}`}>Code details & terms →</a>}</div>:<div class="buybox" id="shopping"><span class="kicker">Your next ride</span><h3>{p.name}</h3><p>See the current price, available options, and delivery details direct from {brand.name}.</p><ProductPrice product={p} offer={offer}/>{offer?.code&&<><p class="note">{productOfferAnswer(offer,brand.name,p)}</p><button class="code-button" data-copy-code={offer.code} data-brand={brand.slug} data-product={p.slug} data-placement={placement} aria-label={`Copy Bike Tested ${brand.name} code ${offer.code}`} aria-live="polite">Copy {offer.code}</button></>}<a class="button blue" href={offer?.url||p.source} target="_blank" rel={offer?'sponsored noopener':'noopener'} data-outbound data-affiliate={offer?'true':'false'} data-brand={brand.slug} data-product={p.slug} data-placement={placement}>{offer?.code?'Check price & availability':'Visit the manufacturer'} <span>↗</span></a><small>{offer?'We may earn a commission when you buy through this link.':'Manufacturer link. No Bike Tested partner offer is currently listed.'}</small>{offer?.code&&<a class="text-link" href={`/promo/${brand.slug}`}>Code details & terms →</a>}<a class="text-link" href={`/brands/${brand.slug}`}>Explore the brand →</a></div>}
