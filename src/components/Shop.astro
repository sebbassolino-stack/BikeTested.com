---
import {brandFor,offerFor} from '../data/catalog';
import {offerAnswer} from '../lib/offers';
const {product:p,placement='review'}=Astro.props;const brand=brandFor(p);const offer=offerFor(p);
---
<div class="buybox"><span class="kicker">Your next ride</span><h3>{p.name}</h3><p>See the current price, available sizes, and delivery options direct from {brand.name}.</p>{offer&&<p class="note">{offerAnswer(offer,brand.name)}</p>}{offer?.code&&<button class="code-button" data-copy-code={offer.code} data-brand={brand.slug} data-placement={placement} aria-live="polite">Copy {offer.code}</button>}<a class="button blue" href={offer?.url||p.source} target="_blank" rel={offer?'sponsored noopener':'noopener'} data-outbound data-affiliate={offer?'true':'false'} data-brand={brand.slug} data-product={p.slug} data-placement={placement}>Shop {brand.name} <span>↗</span></a><small>{offer?'We may earn a commission when you buy through this link.':'Manufacturer link. No Bike Tested partner offer is currently listed.'}</small>{offer?.code&&<a class="text-link" href={`/promo/${brand.slug}`}>Code & terms →</a>}<a class="text-link" href={`/brands/${brand.slug}`}>Explore the brand →</a></div>
