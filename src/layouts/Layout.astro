---
import HolidayLinks from "../components/HolidayLinks.astro";
import '../styles/global.css';
import '@fontsource-variable/dm-sans';
const {title='Better rides start here',description='Independent electric bike reviews, cycling buying guides, and practical comparisons. Find the right ride with Bike Tested.',image='/images/hero.webp',schema=[]}=Astro.props;
const canonicalPath=Astro.url.pathname.replace(/\/index\.html$/,'').replace(/\.html$/,'')||'/';
const canonical=new URL(canonicalPath,'https://biketested.com').href;
const crumbs=Astro.url.pathname!=='/'&&!schema.some(s=>s['@type']==='BreadcrumbList')?[{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://biketested.com'},{'@type':'ListItem',position:2,name:title,item:canonical}]}]:[];
const graph=[{'@type':'Organization','@id':'https://biketested.com/#organization',name:'Bike Tested',url:'https://biketested.com',logo:'https://biketested.com/images/logo.webp',parentOrganization:{'@type':'Organization',name:'Basso Digital'}},{'@type':'WebSite',name:'Bike Tested',url:'https://biketested.com'},...schema,...crumbs];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Bike Tested</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:title" content={`${title} | Bike Tested`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,'https://biketested.com').href}/><meta name="robots" content={['/search','/404'].includes(Astro.url.pathname)?'noindex,follow':'index,follow'}/><meta name="twitter:card" content="summary_large_image"/><meta name="theme-color" content="#101b20"/><link rel="icon" href="/favicon.png"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/></head><body><a class="skip" href="#main">Skip to content</a><header class="header" data-pagefind-ignore><a href="/" class="brand" aria-label="Bike Tested home"><img src="/images/logo.webp" width="246" height="55" alt="Bike Tested"/></a><nav id="navigation" aria-label="Main navigation"><a href="/category/electric-bikes">E-bikes</a><a href="/category/traditional-bikes">Bikes & gear</a><a href="/reviews">Reviews</a><a href="/guides">Guides</a><a href="/deals">Offers</a></nav><div class="header-controls"><a class="search-icon" href="/search" aria-label="Search Bike Tested"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.8" cy="10.8" r="6.6"/><path d="m16 16 5 5"/></svg></a><button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="navigation">Menu <span>☰</span></button></div></header><main id="main" data-pagefind-body><slot/><HolidayLinks/></main><footer data-pagefind-ignore><div class="footer-top"><div><a class="brand" href="/"><img src="/images/logo.webp" width="224" height="50" alt="Bike Tested"/></a><p>Better rides start here.<br/>An independent publication by Basso Digital.</p></div><div><strong>Find your ride</strong><a href="/reviews">Reviews</a><a href="/best">Our shortlist</a><a href="/compare">Compare bikes</a><a href="/brands">Brand directory</a><a href="/deals">Offers & codes</a></div><div><strong>Go further</strong><a href="/guides">Buying guides</a><a href="/category/electric-mobility">Electric mobility</a><a href="/category/gear-and-tech">Gear & tech</a><a href="/category/components">Components</a></div><div><strong>Bike Tested</strong><a href="/about">About us</a><a href="/editorial-standards">How we review</a><a href="/contact">Work with us</a><a href="/affiliate-disclosure">Affiliate disclosure</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Bike Tested</span><div><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div><span>Choose well. Ride more.</span></div></footer><script src="/site.js" is:inline></script></body></html>
