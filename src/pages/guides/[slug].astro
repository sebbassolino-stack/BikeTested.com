---
import Layout from '../../layouts/Layout.astro';import {guides} from '../../data/guides';import {updated} from '../../data/catalog';
export function getStaticPaths(){return guides.map(g=>({params:{slug:g.slug},props:{g}}))};const {g}=Astro.props;
---
<Layout title={g.title} description={g.description} image={g.image} schema={[{'@type':'Article',headline:g.title,description:g.description,datePublished:updated,dateModified:updated,author:{'@type':'Organization',name:'Bike Tested Editorial',url:'https://biketested.com/about'}}]}><div class="wrap"><div class="narrow"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / <a href="/guides">Guides</a> / {g.category}</div><span class="kicker">{g.category}</span><h1>{g.title}</h1><p class="intro">{g.description}</p><p class="meta">By <a href="/about">Bike Tested Editorial</a> · October 19, 2026</p></div><article class="prose"><div class="answer"><span class="kicker">The quick answer</span><p>{g.answer}</p></div>{g.sections.map(([h,t])=><section><h2>{h}</h2><p>{t}</p></section>)}<h2>Put it into practice.</h2><p><a href="/reviews">Explore our current bike reviews</a> or <a href="/compare">compare bikes side by side</a>.</p><h2>Keep reading.</h2><ul>{guides.filter(x=>x.slug!==g.slug).slice(0,3).map(x=><li><a href={`/guides/${x.slug}`}>{x.title}</a></li>)}</ul></article></div></div></Layout>
