---
import Layout from '../../layouts/Layout.astro';
import { guides } from '../../data/guides';
import { guideGroups, readingMinutes } from '../../lib/guides';
const schema=[{'@type':'CollectionPage',name:'Cycling guides and e-bike advice',url:'https://biketested.com/guides',description:'Practical bike comparisons, how-tos and e-bike ownership advice.'},{'@type':'ItemList',itemListElement:guideGroups.flatMap(group=>group.slugs).map((slug,i)=>({'@type':'ListItem',position:i+1,url:`https://biketested.com/guides/${slug}`,name:guides.find(g=>g.slug===slug).title}))}];
---
<Layout title="Cycling guides, e-bike advice & bike maintenance how-tos" description="Clear cycling guides on e-bike motors, sensors, range, tire pressure, chain care, frame types, and commuter gear. Find the answer and your next step." schema={schema}>
  <div class="wrap">
    <div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / Guides</div><h1>A little knowledge.<br/>A better ride.</h1><p class="intro">Choose a bike with confidence. Make sense of the technology. Keep your everyday setup working.</p></div>
    <nav class="guide-hub-nav" aria-label="Browse guide topics">{guideGroups.map(group=><a href={`#${group.id}`}>{group.name} <span>↓</span></a>)}</nav>
    {guideGroups.map(group=><section class="section guide-group" id={group.id}>
      <div class="section-heading"><div><h2>{group.name}</h2><p>{group.description}</p></div></div>
      <div class="guide-hub-grid">{group.slugs.map(slug=>guides.find(g=>g.slug===slug)).map(g=><article class="guide-hub-card"><span class="kicker">{g.category} · {readingMinutes(g)} min read</span><h3><a href={`/guides/${g.slug}`}>{g.title}</a></h3><p>{g.description}</p><a class="text-link" href={`/guides/${g.slug}`}>Read the guide →</a></article>)}</div>
    </section>)}
  </div>
</Layout>
