---
import Layout from '../../layouts/Layout.astro';import ProductCard from '../../components/ProductCard.astro';import {categories,products} from '../../data/catalog';import {guides} from '../../data/guides';
export function getStaticPaths(){return categories.map(c=>({params:{slug:c.slug},props:{c}}))};const {c}=Astro.props;const g=guides.find(x=>x.slug===c.guide);const ps=products.filter(p=>p.category===c.slug);
---
<Layout title={`${c.name}: reviews & buying guides`} description={c.text}><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / {c.name}</div><h1>{c.name}</h1><p class="intro">{c.text}</p></div><section class="section"><div class="section-heading"><h2>Start with the essentials.</h2></div><a class="article-row" href={`/guides/${g.slug}`}><span>↗</span><div><span class="kicker">{g.category}</span><h2>{g.title}</h2><p>{g.description}</p></div><span>→</span></a></section>{ps.length>0&&<section class="section"><div class="section-heading"><h2>Meet the shortlist.</h2><a class="text-link" href="/compare">Compare bikes →</a></div><div class="product-grid">{ps.map(p=><ProductCard product={p}/>)}</div></section>}<section class="trust-band"><div class="wrap"><div><strong>Choose for your kind of ride.</strong><p>Start with your route and your daily routine. Our guides help you work through the details before you shop.</p></div><a class="text-link" href="/guides">All buying guides →</a></div></section></div></Layout>
