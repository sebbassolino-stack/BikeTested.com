---
import Layout from '../../layouts/Layout.astro';
import {niches, offersFor} from '../../data/bf-niches.js';

export function getStaticPaths() {
  return niches.map((niche) => ({params: {niche: niche.slug}, props: {niche}}));
}

const {niche} = Astro.props;
const edition = new Date().toLocaleDateString('en-US', {month: 'long', year: 'numeric', timeZone: 'UTC'});
const offers = offersFor(niche);
const coded = offers.filter((offer) => offer.code);
const statedBenefit = (benefit: string | null | undefined) => {
  const detail = (benefit ?? '').trim();
  if (!detail || /not stated|not recorded|not listed|shown at checkout|amount not|unknown/i.test(detail) || !/\d/.test(detail)) return '';
  return detail;
};
const storeLabel = (url: string, brand: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return `the ${brand} store`;
  }
};
const title = `Black Friday ${niche.title} Deals (${edition})`;
const description = `${coded.length} Bike Tested ${niche.label.toLowerCase()} partner codes, with merchant prices checked November 1, 2026.`;
const pageUrl = `https://biketested.com/black-friday-deals/${niche.slug}`;
const schema = [
  {'@type': 'WebPage', name: title, description, url: pageUrl, datePublished: '2026-11-01', dateModified: '2026-11-01'},
  {'@type': 'FAQPage', mainEntity: niche.faqs.map(([name, text]) => ({'@type': 'Question', name, acceptedAnswer: {'@type': 'Answer', text}}))},
  {'@type': 'BreadcrumbList', itemListElement: [
    {'@type': 'ListItem', position: 1, name: 'Home', item: 'https://biketested.com'},
    {'@type': 'ListItem', position: 2, name: 'Black Friday', item: 'https://biketested.com/black-friday-deals'},
    {'@type': 'ListItem', position: 3, name: niche.label, item: pageUrl},
  ]},
];
---
<Layout title={title} description={description} schema={schema}>
  <article class="niche">
    <nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/black-friday-deals">Black Friday</a> / {niche.label}</nav>
    <header>
      <p class="edition">Black Friday / {edition}</p>
      <h1>Black Friday {niche.title.toLowerCase()} deals ({edition}).</h1>
      <p class="lead">{coded.length} partner codes cover {niche.label.toLowerCase()} on this page, including {niche.leadCodes.join(', ')}. {niche.bestSaving}</p>
      <p class="date">Prices checked November 1, 2026. Published November 1, 2026.</p>
    </header>
    <p class="disclosure">We may earn a commission from qualifying purchases through partner links.</p>
    <p class="back"><a href="/black-friday-deals">All Black Friday and Cyber Monday codes</a> · <a href={niche.giftHref}>{niche.giftLabel}</a></p>
    <section>
      <h2>Codes for {niche.label.toLowerCase()}</h2>
      <ul class="code-cards">
        {coded.map((offer) => <li>
          <a href={offer.path}>{offer.brand}</a>
          <p>{statedBenefit(offer.benefit) || 'Shown at checkout'}</p>
          <p class="code">{offer.code}</p>
          <button type="button" data-holiday-code={offer.code} data-placement="holiday-code-card">Copy</button>
          <a href={offer.url} rel="sponsored noopener" target="_blank" data-commerce-shop data-brand={offer.brand}>Shop {storeLabel(offer.url, offer.brand)}</a>
        </li>)}
      </ul>
    </section>
    <section>
      <h2>Product prices</h2>
      <ul class="picks">
        {niche.picks.map((item) => <li>
          <img src={item.image} alt="" width="160" height="120"/>
          <div>
            <h3>{item.name}</h3>
            <p>{item.variant}: {item.priceLabel}, merchant listing checked {item.checkedOn}.{item.afterLabel ? ` With the code: ${item.afterLabel}.` : ''}</p>
            <p>{item.suits}</p>
            <p><a href={item.reviewPath}>{/\/(best|best-picks|guides)\//.test(item.reviewPath) ? 'Buying guide' : 'Review'}</a>{item.codePath ? <> · <a href={item.codePath}>Code</a></> : null}</p>
          </div>
        </li>)}
      </ul>
    </section>
    <section>
      <h2>Before you buy</h2>
      <p>{niche.buying}</p>
    </section>
    <section>
      <h2>Questions</h2>
      {niche.faqs.map(([name, text]) => <details open><summary>{name}</summary><p>{text}</p></details>)}
    </section>
  </article>
</Layout>
<script>
  document.querySelectorAll('[data-holiday-code]').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.getAttribute('data-holiday-code') || '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Select code above';
      }
    });
  });
</script>
<style>
  .niche {max-width: 1120px; margin: 0 auto; padding: 32px 20px 72px; line-height: 1.6;}
  .niche header, .niche .buying, .niche p, .niche li {max-width: 36em;}
  .niche h1 {font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.08; letter-spacing: -0.03em;}
  .niche h2 {font-size: 1.5rem; margin: 2rem 0 0.8rem;}
  .niche .lead {font-size: 1.15rem;}
  .niche .edition, .niche .date, .niche .disclosure {font-size: 0.85rem;}
  .code-cards, .picks {list-style: none; padding: 0; margin: 0; max-width: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px;}
  .code-cards li, .picks li {max-width: none; border: 1px solid currentColor; border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 8px;}
  .code-cards p, .code-cards a, .code-cards button, .picks p, .picks a {font-size: 13px;}
  .code-cards .code {font-size: 1rem; font-weight: 700;}
  .code-cards button, .code-cards a {min-height: 44px;}
  .picks {grid-template-columns: 1fr;}
  .picks li {flex-direction: row; gap: 16px; align-items: flex-start;}
  .picks img {width: 160px; height: 120px; object-fit: cover; border-radius: 8px;}
  .niche details {margin: 10px 0;}
  @media (max-width: 640px) {
    .picks li {flex-direction: column;}
    .picks img {width: 100%; height: auto;}
  }
</style>
