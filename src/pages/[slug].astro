---
import Layout from '../layouts/Layout.astro';import {pages} from '../data/pages';
export function getStaticPaths(){return pages.map(p=>({params:{slug:p.slug},props:{p}}))};const {p}=Astro.props;
---
<Layout title={p.title} description={p.description}><div class="wrap"><div class="narrow"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / Bike Tested</div><h1>{p.title}</h1><p class="intro">{p.description}</p></div><article class="prose">{p.sections.map(([h,t])=><section><h2>{h}</h2><p>{t}</p></section>)}<nav class="toc" aria-label="Publication information"><a href="/editorial-standards">Editorial standards</a><a href="/affiliate-disclosure">Affiliate disclosure</a><a href="/contact">Contact</a></nav></article></div></div></Layout>
