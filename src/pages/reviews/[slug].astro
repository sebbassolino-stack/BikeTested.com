---
import Layout from '../../layouts/Layout.astro';import Shop from '../../components/Shop.astro';import Faq from '../../components/Faq.astro';import {products,brandFor,updated,comparisons} from '../../data/catalog';
export function getStaticPaths(){return products.map(p=>({params:{slug:p.slug},props:{p}}))};
const {p}=Astro.props;const brand=brandFor(p);const faq=[[`Who is the ${p.model} for?`,p.verdict],[`Is there a Bike Tested ${brand.name} discount code?`,`We do not currently list a confirmed Bike Tested discount code for ${brand.name}. Visit the manufacturer for current pricing and promotions.`],['Are the range figures independently measured?',`The range listed here is the manufacturer's claim. Actual range depends on conditions, rider load, assistance level, and route.`]];
const schema=[{'@type':'Article',headline:`${p.name} review`,description:p.verdict,datePublished:updated,dateModified:updated,author:{'@type':'Organization',name:'Bike Tested Editorial',url:'https://biketested.com/about'},image:`https://biketested.com${p.image}`,about:{'@type':'Product',name:p.name,brand:{'@type':'Brand',name:brand.name}}},{'@type':'FAQPage',mainEntity:faq.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))},{'@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'Home',item:'https://biketested.com'},{'@type':'ListItem',position:2,name:'Reviews',item:'https://biketested.com/reviews'},{'@type':'ListItem',position:3,name:p.name,item:`https://biketested.com/reviews/${p.slug}`}]}];
---
<Layout title={`${p.name} review: ${p.label.toLowerCase()}`} description={p.description} image={p.image} schema={schema}><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / <a href="/reviews">Reviews</a> / {p.name}</div><div class="review-top"><div class="review-photo"><img src={p.image} width="1200" height="800" fetchpriority="high" alt={p.name}/></div><div><span class="kicker">{p.label}</span><h1>{p.name} review</h1><p class="intro">{p.headline} {p.description}</p><a class="button blue" href="#verdict">Our verdict ↓</a><p class="meta">By <a href="/about">Bike Tested Editorial</a> · Published October 19, 2026<br/>{p.evidence} · Editorial evaluation</p></div></div></div><div class="article-grid"><article class="prose"><div id="verdict" class="answer"><span class="kicker">The quick answer</span><p>{p.verdict}</p></div><nav class="toc" aria-label="In this review"><a href="#fit">Strengths & tradeoffs</a><a href="#specifications">Specifications</a><a href="#buying-advice">Buying advice</a></nav><h2 id="fit">Where it fits.</h2><div class="pros-cons"><div><h3>What stands out</h3><ul>{p.strengths.map(s=><li>{s}</li>)}</ul></div><div><h3>Before you buy</h3><ul>{p.tradeoffs.map(s=><li>{s}</li>)}</ul></div></div><h2 id="specifications">The useful details.</h2><p class="note">Manufacturer specifications, checked October 19, 2026. Specifications can vary by configuration.</p><table class="specs"><caption class="hidden">{p.name} manufacturer specifications</caption><tbody>{Object.entries(p.specs).map(([key,val])=><tr><th scope="row">{key}</th><td>{val}</td></tr>)}</tbody></table><p class="note">Source: <a href={p.source} target="_blank" rel="noopener">{brand.name} product page ↗</a>. Advertised range is not a measured Bike Tested result.</p>{p.sections.map(([h,t],i)=><section id={i===2?'buying-advice':undefined}><h2>{h}</h2><p>{t}</p></section>)}<Faq items={faq}/><h2>Keep exploring.</h2><ul>{comparisons.filter(c=>[c.a,c.b].includes(p.slug)).map(c=><li><a href={`/compare/${c.slug}`}>{c.title}</a></li>)}<li><a href="/guides/choose-your-first-ebike">How to choose your first electric bike</a></li><li><a href={`/brands/${brand.slug}`}>{brand.name} brand directory</a></li></ul></article><aside><Shop product={p}/></aside></div></div></Layout>
