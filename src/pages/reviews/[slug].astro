---
import Layout from '../../layouts/Layout.astro';import {guides} from '../../data/guides';import Shop from '../../components/Shop.astro';import Faq from '../../components/Faq.astro';import {products,brandFor,comparisons,offerFor,categories} from '../../data/catalog';
import {productOfferFaq} from '../../lib/offers';import {priceDateLabel} from '../../lib/pricing';
export function getStaticPaths(){return products.map(p=>({params:{slug:p.slug},props:{p}}))};
const {p}=Astro.props;const brand=brandFor(p);const offer=offerFor(p);const category=categories.find(c=>c.slug===p.category);const alternatives=(p.relatedReviews||[]).map(r=>({r,product:products.find(x=>x.slug===r.slug)})).filter(x=>x.product);
const baseFaq=p.faqs||[[`Who should choose the ${p.name}?`,p.verdict],[`What range does the ${p.name} claim?`,`The listed range is the manufacturer's claim. Real distance depends on conditions, rider load, assistance level, and route.`],[`What should I check before ordering the ${p.name}?`,p.tradeoffs.join('. ')]];
const faq=[...baseFaq,productOfferFaq(offer,brand.name,p)];
const schema=[{'@type':'Article',headline:`${p.name} review`,description:p.description,datePublished:p.publishedOn,dateModified:p.updatedOn,author:{'@type':'Organization',name:'Bike Tested Editorial',url:'https://biketested.com/about'},image:`https://biketested.com${p.image}`,about:{'@type':'Thing',name:p.name,description:p.description,image:`https://biketested.com${p.image}`}},{'@type':'FAQPage',mainEntity:faq.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://biketested.com'},{'@type':'ListItem',position:2,name:'Reviews',item:'https://biketested.com/reviews'},{'@type':'ListItem',position:3,name:p.name,item:`https://biketested.com/reviews/${p.slug}`}]}];
const relatedGuides=guides.filter(g=>g.products?.includes(p.slug));const hasEbikes=p.category==='electric-bikes'&&!relatedGuides.some(g=>g.slug==='choose-your-first-ebike');
---
<Layout title={`${p.name} review: ${p.label.toLowerCase()}`} description={p.description} image={p.image} schema={schema}><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / <a href="/reviews">Reviews</a> / {p.name}</div><div class="review-top"><div class="review-photo"><img src={p.image} width={p.imageWidth||1200} height={p.imageHeight||800} fetchpriority="high" alt={p.imageAlt||p.name}/></div><div class="review-top-copy"><span class="kicker">{p.label}</span><h1>{p.name} review</h1><p class="intro">{p.headline} {p.description}</p><p class="meta">By <a href="/about">Bike Tested Editorial</a> · Published <time datetime={p.publishedOn}>{priceDateLabel(p.publishedOn)}</time>{p.updatedOn!==p.publishedOn&&<> · Updated <time datetime={p.updatedOn}>{priceDateLabel(p.updatedOn)}</time></>}<br/>{p.evidence} · Editorial evaluation</p><Shop product={p} placement="review-hero"/></div></div></div><div class="article-grid"><article class="prose"><div id="verdict" class="answer"><span class="kicker">The quick answer</span><p>{p.verdict}</p></div><nav class="toc" aria-label="In this review"><a href="#fit">Strengths & tradeoffs</a><a href="#specifications">Specifications</a><a href="#buying-advice">Buying advice</a></nav><h2 id="fit">Where it fits.</h2><div class="pros-cons"><div><h3>What stands out</h3><ul>{p.strengths.map(s=><li>{s}</li>)}</ul></div><div><h3>Before you buy</h3><ul>{p.tradeoffs.map(s=><li>{s}</li>)}</ul></div></div><h2 id="specifications">The useful details.</h2><p class="note">Manufacturer specifications checked {priceDateLabel(p.specsCheckedOn)}. Specifications can vary by configuration.</p><table class="specs"><caption class="hidden">{p.name} manufacturer specifications</caption><tbody>{Object.entries(p.specs).map(([key,val])=><tr><th scope="row">{key}</th><td>{val}</td></tr>)}</tbody></table><p class="note">Source: <a href={p.source} target="_blank" rel="noopener">{brand.name} product page ↗</a>{p.specs?.["Claimed range"]&&<>. Advertised range is not a measured Bike Tested result</>}.</p>{p.sourceLinks?.length>0&&<ul class="source-links" aria-label="Additional manufacturer sources">{p.sourceLinks.map(source=><li><a href={source.url} target="_blank" rel="noopener">{source.label} ↗</a></li>)}</ul>}{p.sections.map(([h,t],i)=><section id={i===p.sections.length-1?'buying-advice':undefined}><h2>{h}</h2><p>{t}</p></section>)}<Faq items={faq}/><h2>Keep exploring.</h2><ul>{comparisons.filter(c=>[c.a,c.b].includes(p.slug)).map(c=><li><a href={`/compare/${c.slug}`}>{c.title}</a></li>)}{alternatives.map(({r,product})=><li>{r.reason} <a href={`/reviews/${product.slug}`}>{product.name}: review →</a></li>)}{relatedGuides.map(g=><li><a href={`/guides/${g.slug}`}>{g.title}</a></li>)}{hasEbikes&&<li><a href="/guides/choose-your-first-ebike">How to choose your first electric bike</a></li>}<li><a href={`/category/${p.category}`}>Explore {category?.name||'related products'} →</a></li><li><a href={`/brands/${brand.slug}`}>{brand.name} brand directory</a></li>{offer?.code&&<li><a href={`/promo/${brand.slug}`}>{brand.name} offer details</a></li>}</ul><section class="closing-shop"><h2>Check the exact product listing.</h2><Shop product={p} placement="review-closing" compact={true}/></section></article></div></div></Layout>
