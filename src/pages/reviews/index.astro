---
import Layout from '../../layouts/Layout.astro';import ProductCard from '../../components/ProductCard.astro';import {products} from '../../data/catalog';
---
<Layout title="Bike and cycling product reviews" description="Explore Bike Tested reviews of electric bikes, electric mobility and cycling products. Filter by category or riding style and compare specifications, fit, strengths and ownership considerations."><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / Reviews</div><h1>Find your next<br/>great ride.</h1><p class="intro">Thoughtful reviews for the way you actually ride. Find the right fit, then get into the details.</p></div><div class="filters"><input id="product-search" type="search" placeholder="Search products, types, or brands" aria-label="Search products, types, or brands"/><select id="category-filter" aria-label="Filter by product category"><option value="all">Every category</option><option value="electric-bikes">Electric bikes</option><option value="electric-mobility">Electric mobility</option><option value="cycling-technology">Cycling technology</option><option value="gear-and-tech">Gear & tech</option><option value="components">Components</option><option value="traditional-bikes">Traditional bikes</option></select><select id="use-filter" aria-label="Filter by riding style"><option value="all">Every riding style</option><option value="commute">Commuting</option><option value="weekend">Weekend rides</option><option value="city">City riding</option></select><a class="button dark-outline" href="/compare">Compare e-bikes ↗</a></div><p id="result-count" class="disclosure" aria-live="polite">{products.length} reviews</p><div class="product-grid">{products.map(p=><ProductCard product={p}/>)}</div><p id="no-results" class="empty" hidden>No matching reviews. Try another product type, category, or riding style.</p><div class="section"><p class="note">Our reviews evaluate manufacturer specifications and ownership considerations. <a class="text-link" href="/editorial-standards">How we review →</a></p></div></div></Layout>
