---
import Layout from '../../layouts/Layout.astro';import ProductCard from '../../components/ProductCard.astro';import {products} from '../../data/catalog';
---
<Layout title="Electric bike reviews & product directory" description="Explore Bike Tested electric bike reviews. Filter by riding style and compare manufacturer specifications, rider fit, strengths, and ownership tradeoffs."><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / Reviews</div><h1>Find your next<br/>great ride.</h1><p class="intro">Thoughtful reviews for the way you actually ride. Find the right fit, then get into the details.</p></div><div class="filters"><input id="product-search" type="search" placeholder="Search bikes or brands" aria-label="Search bikes or brands"/><select id="use-filter" aria-label="Filter by riding style"><option value="all">Every riding style</option><option value="commute">Commuting</option><option value="weekend">Weekend rides</option><option value="city">City riding</option></select><a class="button dark-outline" href="/compare">Compare bikes ↗</a></div><p id="result-count" class="disclosure" aria-live="polite">{products.length} reviews</p><div class="product-grid">{products.map(p=><ProductCard product={p}/>)}</div><p id="no-results" class="empty" hidden>No matching bikes. Try another brand or riding style.</p><div class="section"><p class="note">Our current reviews evaluate manufacturer specifications and ownership considerations. <a class="text-link" href="/editorial-standards">How we review →</a></p></div></div></Layout>
