---
import Layout from '../../layouts/Layout.astro';import Comparison from '../../components/Comparison.astro';import {products,comparisons} from '../../data/catalog';
export function getStaticPaths(){return comparisons.map(c=>({params:{slug:c.slug},props:{c}}))};const {c}=Astro.props;const a=products.find(p=>p.slug===c.a),b=products.find(p=>p.slug===c.b);
---
<Layout title={c.title} description={c.description}><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / <a href="/compare">Compare</a></div><h1>{c.title}</h1><p class="intro">{c.description}</p></div><Comparison a={a} b={b}/><div class="section"><a href="/compare" class="button blue">Build another comparison →</a></div></div></Layout>
