---
import Layout from '../../layouts/Layout.astro';import Comparison from '../../components/Comparison.astro';import {products,comparisons} from '../../data/catalog';
---
<Layout title="Compare electric bikes side by side"><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / Compare</div><h1>The details.<br/>Side by side.</h1><p class="intro">Compare riding priorities and manufacturer specifications. Find the bike that fits your routine.</p></div><form class="compare-picker" id="compare-form"><select name="a" aria-label="First bike">{products.map(p=><option value={p.slug}>{p.name}</option>)}</select><span>vs</span><select name="b" aria-label="Second bike">{products.map((p,i)=><option value={p.slug} selected={i===1}>{p.name}</option>)}</select><button class="button blue" type="submit">Compare →</button></form><p id="compare-message" class="disclosure" role="status"></p><div id="comparison-default"><Comparison a={products[0]} b={products[1]}/></div><div id="comparison-live" hidden></div><div class="section"><h2>Explore the comparisons.</h2><div class="article-list">{comparisons.map(c=><a class="article-row" href={`/compare/${c.slug}`}><span>↗</span><div><h2>{c.title}</h2><p>{c.description}</p></div><span>→</span></a>)}</div></div></div><script define:vars={{products}}>window.bikeProducts=products;</script></Layout>
