---
import Layout from '../layouts/Layout.astro';import ProductCard from '../components/ProductCard.astro';import {products,categories} from '../data/catalog';import {guides} from '../data/guides';
---
<Layout><section class="hero"><img class="hero-photo" src="/images/hero.webp" width="2000" height="2635" fetchpriority="high" alt="Two riders enjoying Aventon electric bikes by the marina"/><div class="wrap hero-content"><h1>Better rides<br/>start here.</h1><p>Find your next bike.<br/>Make every mile count.</p><div class="hero-actions"><a class="button lime" href="/reviews">Explore the reviews <span>→</span></a><a class="button outline" href="#find-your-ride">Find your ride <span>↗</span></a></div></div><div class="hero-caption">The everyday escape<span>A smarter way to get there.</span></div><a href="/reviews/aventon-pace-5-rec" class="hero-count">IN FOCUS / AVENTON PACE 5 REC ↗</a></section><div class="wrap category-strip">{categories.slice(0,4).map((c,i)=><a href={`/category/${c.slug}`}><div><small>0{i+1} / EXPLORE</small>{c.name}</div><span>↗</span></a>)}</div><section class="wrap section"><div class="section-heading"><div><h2>A better way to choose.</h2><p>Standout bikes. Clear recommendations. The details that matter.</p></div><a class="text-link" href="/reviews">All reviews →</a></div><div class="editorial-grid"><ProductCard product={products[0]} featured/><div class="editorial-side"><ProductCard product={products[1]}/><ProductCard product={products[2]}/></div></div></section><section class="ride-section" id="find-your-ride"><div class="ride-content"><h2>Your ride.<br/>Your rules.</h2><p>Different destinations, same good feeling. Start with the kind of riding you want to do.</p><div class="ride-tabs" aria-label="Choose your riding style">{['Commute','Weekend','City'].map((t,i)=><button data-ride={t.toLowerCase()} aria-pressed={i===0?'true':'false'}>{t}</button>)}</div><a class="ride-result" href="/reviews/lectric-xpress2" aria-live="polite">Meet the Lectric XPress2 Commuter →</a></div><img class="ride-image" src="/images/lifestyle.webp" width="1200" height="1581" loading="lazy" alt="Aventon electric bike lifestyle photography"/></section><section class="wrap section"><div class="section-heading"><h2>The knowledge<br/>to go further.</h2><a class="text-link" href="/guides">All guides →</a></div><div class="guide-grid">{['torque-sensor-vs-cadence-sensor','bike-tire-pressure','how-to-clean-lube-bike-chain'].map(slug=>guides.find(g=>g.slug===slug)).map((g,i)=><article class="guide-card"><span class="guide-num">0{i+1} / {g.category.toUpperCase()}</span><h3><a href={`/guides/${g.slug}`}>{g.title}</a></h3><p>{g.description}</p><a class="text-link" href={`/guides/${g.slug}`}>Read the guide →</a></article>)}</div></section><section class="trust-band"><div class="wrap"><div><strong>Good advice earns its place.</strong><p>We put rider fit, useful details, and ownership considerations first. Every recommendation comes with its strengths and tradeoffs, never a numerical score.</p></div><a class="button dark-outline" href="/editorial-standards">Our editorial approach ↗</a></div></section></Layout>
