---
import Layout from '../layouts/Layout.astro';import OfferBox from '../components/OfferBox.astro';import Faq from '../components/Faq.astro';import {offers,categories} from '../data/catalog';import {faqSchema} from '../lib/offers';
const active=offers.filter(o=>o.status==='active');const coded=active.filter(o=>o.code);const linkOnly=active.filter(o=>!o.code);
const faq=[['How do Bike Tested discount codes work?','Copy the exact code from the brand’s offer page, open its partner store link and enter the code at checkout. Check the product eligibility and final total before paying.'],['Do all affiliate links include a discount?','No. Some partners supplied a reader code; others supplied an affiliate link only. A link-only partnership does not establish an automatic saving.'],['Have these codes been checked on specific products?','Some offer pages record code acceptance for one exact model and variant. That observation does not establish a completed order or broader eligibility. Each offer page separates the reported benefit from unspecified eligibility, stacking and expiry terms.']];
---
<Layout title="E-bike & scooter discount codes and partner offers" description={`${coded.length} reader codes and ${linkOnly.length} link-only partners for electric bikes, scooters, cycling gear and more. Copy the exact code and check the storefront and terms.`} schema={[faqSchema(faq)]}>
<div class="wrap"><div class="page-head offers-head"><div><div class="breadcrumb"><a href="/">Home</a> / Offers & codes</div><span class="kicker">The Bike Tested partner directory</span><h1>A better ride.<br/>A considered buy.</h1><p class="intro">Reader codes, useful buying advice and a direct route to our partner stores.</p></div><div class="offer-stat"><strong>{coded.length}</strong><span>reader codes</span><strong>{linkOnly.length}</strong><span>link-only partners</span></div></div>
<p class="offer-source">Partner roster supplied <time datetime="2026-10-28">October 28, 2026</time>. Reported discounts are identified on each page; eligibility and code acceptance are specific to the merchant’s product configuration. We may earn a commission on qualifying purchases.</p>
<div class="partner-controls"><label>Find a brand<input type="search" id="partner-search" placeholder="Brand name or code" autocomplete="off"/></label><label>Offer type<select id="partner-type"><option value="all">All partners</option><option value="code">Reader codes</option><option value="link">Partner links only</option></select></label><label>Explore<select id="partner-category"><option value="all">All categories</option>{categories.filter(c=>active.some(o=>o.category===c.slug)).map(c=><option value={c.slug}>{c.name}</option>)}<option value="rc-equipment">FPV & RC equipment</option></select></label></div>
<p class="note" id="partner-count" role="status" aria-live="polite">{active.length} partners</p><div class="brand-grid partner-grid">{active.map(o=><OfferBox offer={o}/>)}</div><p class="offer-note" id="partner-empty" hidden>No partners match these filters. Try another name or choose all categories.</p><div class="narrow section"><Faq items={faq}/><p class="note">Looking for an editorial review? <a href="/reviews">Explore our published reviews</a> or <a href="/guides">start with a buying guide</a>.</p></div></div></Layout>
