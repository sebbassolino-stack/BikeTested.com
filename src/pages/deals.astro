---
import Layout from '../layouts/Layout.astro';import OfferBox from '../components/OfferBox.astro';import {brands,offers} from '../data/catalog';
---
<Layout title="Electric bike offers & discount codes" description="Find Bike Tested partner offer information and official bike brand stores. We list discount codes only when the exact offer and eligibility are confirmed."><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / Offers</div><h1>A better ride.<br/>A considered buy.</h1><p class="intro">Partner offers, reader codes, and a direct route to the brands we cover.</p></div><div class="offer-note"><h2>Good offers start with clear terms.</h2><p>{offers.some(o=>o.status==='active')?'Explore our current partner offers below. Check the eligible storefront, exclusions, and final total before completing your purchase.':'No confirmed Bike Tested partner codes are listed yet. Explore the official stores below for their current offers, or use our reviews to decide which bike belongs on your shortlist.'}</p><a class="text-link" href="/contact">Brands: work with Bike Tested ↗</a></div><div class="brand-grid section">{offers.filter(o=>o.status==='active').map(o=><OfferBox offer={o}/>)}{brands.map(b=><article class="brand-tile"><span class="kicker">Official brand store</span><h2>{b.name}</h2><p>{b.description}</p><a class="button blue" href={b.url} target="_blank" rel="noopener" data-outbound data-affiliate="false" data-brand={b.slug} data-placement="offers">Visit {b.name} ↗</a><a class="text-link" href={`/brands/${b.slug}`}>Read our coverage →</a></article>)}</div></div></Layout>
