---
// Calendar edition for promo titles (build month, New York); the monthly rebuild rolls it over. Not a verification date.
const editionMonth = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'America/New_York' });
import Layout from '../../layouts/Layout.astro';import Faq from '../../components/Faq.astro';import PartnerOffer from '../../components/PartnerOffer.astro';
import ProductCard from '../../components/ProductCard.astro';
import {offers,brands,products} from '../../data/catalog';import {guides} from '../../data/guides';
import {offerAnswer,offerFaq,offerSchema,faqSchema,pathFor,offerCheckSummary} from '../../lib/offers';
import {nicheForPartner} from '../../data/bf-niches.js';
import PromoMath from '../../components/PromoMath.astro';
import {savingFor,promoHeadline} from '../../lib/promo-format.mjs';
export function getStaticPaths(){return offers.filter(o=>o.status==='active'&&o.code).map(o=>({params:{slug:o.brand},props:{o}}))};
const {o}=Astro.props;const brand=brands.find(b=>b.slug===o.brand);const saving=savingFor(brand.name,o.code,o.benefit);const headline=promoHeadline(brand.name,o.code,saving);const answer=offerAnswer(o,brand.name);const faq=offerFaq(o,brand.name);const path=pathFor(o);
const reading=guides.filter(g=>path.guides.includes(g.slug));const coverage=products.filter(p=>p.brand===o.brand);
const productCheck=offerCheckSummary(o)||'Not recorded';
const others=offers.filter(x=>x.code&&x.brand!==o.brand&&x.category===o.category).slice(0,3);
const niche=nicheForPartner(o.brand, o.category);
---
<Layout title={headline} description={answer} schema={[offerSchema(o,brand.name),faqSchema(faq)]}>
<div class="wrap"><div class="page-head promo-head"><div class="breadcrumb"><a href="/">Home</a> / <a href="/deals">Offers & codes</a> / {brand.name}</div><span class="kicker">Reader offer · {o.eligibleStore}</span><h1>{headline}</h1><PromoMath code={o.code} saving={saving} store={o.eligibleStore}/><p class="intro">{answer}</p><p><a href="/black-friday-deals">Compare this offer with the other partner codes for Black Friday and Cyber Monday</a>{niche ? <> · <a href={`/black-friday-deals/${niche.slug}`}>Black Friday {niche.label.toLowerCase()} deals</a></> : null}</p></div>
<div class="promo-layout"><article class="prose"><PartnerOffer offer={o} name={brand.name}/>
<nav class="toc" aria-label="On this page"><a href="#use-code">How to use it</a><a href="#terms">Offer terms</a><a href="#buying">Before you choose</a><a href="#questions">FAQs</a></nav>
<h2 id="use-code">A few clicks to your next ride.</h2><ol class="guide-steps"><li>Copy <strong>{o.code}</strong> exactly{o.code.includes('%')?', including the percent symbol':''}.</li><li>Open the <a href={o.url} rel="sponsored noopener" target="_blank" data-outbound data-affiliate="true" data-brand={o.brand} data-placement="promo-steps">{brand.name} partner shop</a> at {o.eligibleStore} and select your product and variant.</li><li>Paste the code into the checkout discount field. {saving?`${saving} comes off your order total.`:'The saving shows in your order total.'}</li></ol>
<h2 id="terms">The details that matter.</h2><dl class="offer-facts"><div><dt>Reader code</dt><dd><code>{o.code}</code></dd></div><div><dt>Reader benefit</dt><dd>{o.benefit||'Shown at checkout'}</dd></div><div><dt>Storefront</dt><dd>{o.eligibleStore}</dd></div><div><dt>Expiry</dt><dd>No expiry date</dd></div></dl><p>Enter the code in the discount field at checkout. Use one code per order.</p>
<h2 id="buying">Choosing from {brand.name}.</h2><p>{brand.description}</p>{path.checks.map(([h,t])=><section><h3>{h}</h3><p>{t}</p></section>)}
{coverage.length>0&&<><h2>Our {brand.name} reviews</h2><div class="product-grid promo-products">{coverage.map(p=><ProductCard product={p}/>)}</div></>}
{reading.length>0&&<div class="guide-next"><h2>Make a more informed choice.</h2><ul>{reading.map(g=><li><a href={`/guides/${g.slug}`}>{g.title}</a></li>)}</ul></div>}
<div id="questions"><Faq items={faq}/></div><p class="note">For offer corrections, <a href="/contact">contact Bike Tested</a> with the brand, storefront and exact code. Retail order questions should go to the seller.</p></article>
<aside class="promo-aside"><span class="kicker">Good decisions first</span><h2>Choose well.<br/>Ride more.</h2><p>A code is the last step. Start with the product, the fit and the support you need.</p><a class="text-link" href={`/brands/${brand.slug}`}>{brand.name} brand guide →</a><a class="text-link" href={`/category/${o.category}`}>Explore {path.label.toLowerCase()} →</a>{others.length>0&&<><h3>More reader offers</h3>{others.map(x=><a class="text-link" href={`/promo/${x.brand}`}>{brands.find(b=>b.slug===x.brand).name}: {x.benefit||'reader code'} →</a>)}</>}<a class="text-link" href="/deals">All partner offers →</a></aside></div></div></Layout>
