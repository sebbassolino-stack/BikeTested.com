---
import Layout from '../../layouts/Layout.astro';import Faq from '../../components/Faq.astro';import {offers,brands,products} from '../../data/catalog';
export function getStaticPaths(){return offers.filter(o=>o.status==='active'&&o.code).map(o=>({params:{slug:o.brand},props:{o}}))};
const {o}=Astro.props;const brand=brands.find(b=>b.slug===o.brand);const answer=`The ${brand.name} discount code is ${o.code} for ${o.benefit} at ${o.eligibleStore}. ${o.terms}`;const faq=[[`What is the ${brand.name} discount code?`,answer],['How do I use this code?',`Open the shop link, choose eligible products, enter ${o.code} at checkout, and confirm the final total before paying.`],['Can I combine this offer with another promotion?',o.stackingTerms||'Combining promotions has not been confirmed. Check the merchant’s terms and your checkout total.']];
---
<Layout title={`${brand.name} discount code ${o.code}: ${o.benefit}`} description={answer} schema={[{'@type':'Offer',name:`${brand.name}: ${o.benefit}`,description:answer,url:o.url,seller:{'@type':'Organization',name:brand.name}}, {'@type':'FAQPage',mainEntity:faq.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))}]}><div class="wrap"><div class="narrow"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / <a href="/deals">Offers</a></div><h1>{brand.name} discount code</h1><p class="intro">{answer}</p></div><div class="offer-note"><button class="code-button" data-copy-code={o.code} data-brand={o.brand}>Copy {o.code}</button><a class="button lime" href={o.url} target="_blank" rel="sponsored noopener" data-outbound data-affiliate="true" data-brand={o.brand} data-placement="promo">Shop {brand.name} ↗</a><p class="disclosure">We may earn a commission when you buy through this link.</p></div><div class="prose"><h2>Before checkout.</h2><p>{o.terms}</p><p>Offer details checked {o.checkedOn}. {o.checkoutTestedOn?`Checkout last tested ${o.checkoutTestedOn}.`:''}</p><Faq items={faq}/><a href={`/brands/${o.brand}`} class="text-link">Explore our {brand.name} coverage →</a></div></div></div></Layout>
