---
import Layout from '../../layouts/Layout.astro';import Faq from '../../components/Faq.astro';import PartnerOffer from '../../components/PartnerOffer.astro';
import ProductCard from '../../components/ProductCard.astro';
import {offers,brands,products} from '../../data/catalog';import {guides} from '../../data/guides';
import {offerAnswer,offerFaq,offerSchema,faqSchema,pathFor} from '../../lib/offers';
export function getStaticPaths(){return offers.filter(o=>o.status==='active'&&o.code).map(o=>({params:{slug:o.brand},props:{o}}))};
const {o}=Astro.props;const brand=brands.find(b=>b.slug===o.brand);const answer=offerAnswer(o,brand.name);const faq=offerFaq(o,brand.name);const path=pathFor(o);
const reading=guides.filter(g=>path.guides.includes(g.slug));const coverage=products.filter(p=>p.brand===o.brand);
const others=offers.filter(x=>x.code&&x.brand!==o.brand&&x.category===o.category).slice(0,3);
---
<Layout title={`${brand.name} discount code ${o.code}${o.benefit?`: ${o.benefit}`:''}`} description={answer} schema={[offerSchema(o,brand.name),faqSchema(faq)]}>
<div class="wrap"><div class="page-head promo-head"><div class="breadcrumb"><a href="/">Home</a> / <a href="/deals">Offers & codes</a> / {brand.name}</div><span class="kicker">Reader offer · {o.eligibleStore}</span><h1>{brand.name}<br/>discount code</h1><p class="intro">{answer}</p></div>
<div class="promo-layout"><article class="prose"><PartnerOffer offer={o} name={brand.name}/>
<nav class="toc" aria-label="On this page"><a href="#use-code">How to use it</a><a href="#terms">Offer terms</a><a href="#buying">Before you choose</a><a href="#questions">FAQs</a></nav>
<h2 id="use-code">A few clicks to your next ride.</h2><ol class="guide-steps"><li>Copy <strong>{o.code}</strong> exactly{o.code.includes('%')?', including the percent symbol':''}.</li><li>Open the <a href={o.url} rel="sponsored noopener" target="_blank" data-outbound data-affiliate="true" data-brand={o.brand} data-placement="promo-steps">{brand.name} partner shop</a> at {o.eligibleStore} and select your product and variant.</li><li>Paste the code into the checkout discount field. Check the item price, applied saving, delivery charges and final total.</li><li>Complete the order only when the total and merchant terms suit you.</li></ol>
<h2 id="terms">The details that matter.</h2><dl class="offer-facts"><div><dt>Reader code</dt><dd><code>{o.code}</code></dd></div><div><dt>Reported benefit</dt><dd>{o.benefit||'Discount amount not supplied'}</dd></div><div><dt>Storefront</dt><dd>{o.eligibleStore}</dd></div><div><dt>Offer source</dt><dd>Bike Tested partner roster, {o.reportedOn}</dd></div><div><dt>Eligibility & expiry</dt><dd>{o.checkoutTestProduct?`Code acceptance${o.checkoutTestProduct.stage==='cart'?' in the cart':''} recorded only for ${o.checkoutTestProduct.name}, ${o.checkoutTestProduct.variantLabel}. Broader eligibility and expiry are not supplied.`:o.codeCheckProduct?o.codeCheckProduct.result==='invalid-code'?`Checkout rejected the code as invalid for ${o.codeCheckProduct.name}, ${o.codeCheckProduct.variantLabel}; the ${o.codeCheckProduct.baseFormatted} item price remained unchanged. No saving is confirmed for that variant; broader eligibility and expiry are not supplied.`:`A ${o.codeCheckProduct.stage} check for ${o.codeCheckProduct.name}, ${o.codeCheckProduct.variantLabel} showed ${o.codeCheckProduct.discountFormatted} off. No saving is confirmed for that variant; broader eligibility and expiry are not supplied.`:'Eligibility and expiry are not specified by the supplied offer.'}</dd></div><div><dt>Product check</dt><dd>{o.checkoutTestedOn?`${o.checkoutTestedOn} · ${o.checkoutTestProduct?.name||o.codeCheckProduct?.name||'exact product scope not recorded'}${o.checkoutTestProduct?`, ${o.checkoutTestProduct.variantLabel} only`:o.codeCheckProduct?`, ${o.codeCheckProduct.variantLabel} only`:''}`:'Not recorded'}</dd></div></dl><p>{o.terms}</p><p>If the code is rejected, remove any conflicting promotion and check the exact storefront and model with the seller. An affiliate link can credit our publication even when no coupon applies; it does not guarantee a saving.</p>
<h2 id="buying">Choosing from {brand.name}.</h2><p>{brand.description}</p>{path.checks.map(([h,t])=><section><h3>{h}</h3><p>{t}</p></section>)}
{coverage.length>0&&<><h2>Our {brand.name} reviews</h2><div class="product-grid promo-products">{coverage.map(p=><ProductCard product={p}/>)}</div></>}
{reading.length>0&&<div class="guide-next"><h2>Make a more informed choice.</h2><ul>{reading.map(g=><li><a href={`/guides/${g.slug}`}>{g.title}</a></li>)}</ul></div>}
<div id="questions"><Faq items={faq}/></div><p class="note">For offer corrections, <a href="/contact">contact Bike Tested</a> with the brand, storefront and exact code. Retail order questions should go to the seller.</p></article>
<aside class="promo-aside"><span class="kicker">Good decisions first</span><h2>Choose well.<br/>Ride more.</h2><p>A code is the last step. Start with the product, the fit and the support you need.</p><a class="text-link" href={`/brands/${brand.slug}`}>{brand.name} brand guide →</a><a class="text-link" href={`/category/${o.category}`}>Explore {path.label.toLowerCase()} →</a>{others.length>0&&<><h3>More reader offers</h3>{others.map(x=><a class="text-link" href={`/promo/${x.brand}`}>{brands.find(b=>b.slug===x.brand).name}: {x.benefit||'reader code'} →</a>)}</>}<a class="text-link" href="/deals">All partner offers →</a></aside></div></div></Layout>
