---
import Layout from "../layouts/Layout.astro";
import HolidayShopping from "../components/HolidayShopping.astro";
import {config,offers} from "../data/holiday-2026.js";
const edition=new Date().toLocaleDateString('en-US',{month:'long',year:'numeric',timeZone:'UTC'});
---
<Layout title={`Black Friday & Cyber Monday Cycling Deals (${edition}) | BikeTested`} description="Compare BikeTested partner codes before Black Friday November 27 and Cyber Monday November 30, 2026. Current benefits, store links and sale-comparison advice."><HolidayShopping kind="deals" config={config} offers={offers}/></Layout>
