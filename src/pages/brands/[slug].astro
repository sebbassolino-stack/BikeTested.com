---
import Layout from '../../layouts/Layout.astro';import PartnerOffer from '../../components/PartnerOffer.astro';import ProductCard from '../../components/ProductCard.astro';import Faq from '../../components/Faq.astro';
import {brands,products,offers} from '../../data/catalog';import {guides} from '../../data/guides';import {offerAnswer,offerFaq,faqSchema,pathFor} from '../../lib/offers';
export function getStaticPaths(){return brands.map(b=>({params:{slug:b.slug},props:{b}}))};const {b}=Astro.props;
const offer=offers.find(o=>o.brand===b.slug&&o.status==='active');const coverage=products.filter(p=>p.brand===b.slug);const path=offer?pathFor(offer):null;const reading=path?guides.filter(g=>path.guides.includes(g.slug)):[];const faq=offer?offerFaq(offer,b.name):[];
---
<Layout title={`${b.name}${coverage.length?' reviews & brand guide':' partner store & buying guide'}`} description={b.description} schema={faq.length?[faqSchema(faq)]:[]}><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / <a href="/brands">Brands</a> / {b.name}</div><span class="kicker">{path?.label||'Brand guide'}</span><h1>{b.name}</h1><p class="intro">{b.description}</p>{!offer&&<a class="text-link" href={b.url} target="_blank" rel="noopener" data-outbound data-affiliate="false" data-brand={b.slug} data-placement="brand">Visit the official store ↗</a>}</div>
{offer&&<div class="promo-layout"><article class="prose">{offer.code?<div class="answer"><span class="kicker">Reader discount</span><p>{offerAnswer(offer,b.name)}</p><a class="text-link" href={`/promo/${b.slug}`}>{b.name} discount code & full terms →</a></div>:<div class="answer"><span class="kicker">Shop with Bike Tested</span><p>{offerAnswer(offer,b.name)}</p></div>}<PartnerOffer offer={offer} name={b.name} placement="brand"/><h2>Before you order from {b.name}.</h2>{path.checks.map(([h,t])=><section><h3>{h}</h3><p>{t}</p></section>)}<Faq items={faq}/></article><aside class="promo-aside"><span class="kicker">The useful reading</span><h2>Start with<br/>the right questions.</h2>{reading.map(g=><a class="text-link" href={`/guides/${g.slug}`}>{g.title} →</a>)}<a class="text-link" href="/deals">All partner offers →</a><a class="text-link" href="/editorial-standards">How we evaluate products →</a></aside></div>}
{coverage.length>0&&<section class="section"><div class="section-heading"><h2>Our {b.name} coverage.</h2></div><div class="product-grid">{coverage.map(p=><ProductCard product={p}/>)}</div></section>}
{!offer&&<section class="offer-note"><h2>{b.name} offers & codes</h2><p>We do not currently list a confirmed Bike Tested discount code for {b.name}. Check the official store for current pricing, delivery and any manufacturer promotions.</p><a class="text-link" href="/deals">Explore offers & codes →</a></section>}</div></Layout>
