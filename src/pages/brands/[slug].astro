---
import Layout from '../../layouts/Layout.astro';import OfferBox from '../../components/OfferBox.astro';import ProductCard from '../../components/ProductCard.astro';import {brands,products,offers} from '../../data/catalog';
export function getStaticPaths(){return brands.map(b=>({params:{slug:b.slug},props:{b}}))};const {b}=Astro.props;
---
<Layout title={`${b.name} bike reviews & brand guide`} description={b.description}><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / <a href="/brands">Brands</a> / {b.name}</div><h1>{b.name}</h1><p class="intro">{b.description}</p><a class="text-link" href={b.url} target="_blank" rel="noopener">Visit the official store ↗</a></div><section class="section"><div class="section-heading"><h2>Explore the lineup.</h2></div><div class="product-grid">{products.filter(p=>p.brand===b.slug).map(p=><ProductCard product={p}/>)}</div></section>{offers.filter(o=>o.brand===b.slug&&o.status==='active').map(o=><OfferBox offer={o} placement="brand"/>)}{!offers.some(o=>o.brand===b.slug&&o.status==='active')&&<section class="offer-note"><h2>{b.name} offers & codes</h2><p>We do not currently list a confirmed Bike Tested discount code for {b.name}. Check the official store for current pricing, delivery, and any manufacturer promotions.</p><a class="text-link" href="/deals">Explore offers & codes →</a></section>}</div></Layout>
