---
import Layout from '../../layouts/Layout.astro';import {brands} from '../../data/catalog';
---
<Layout title="Cycling brand directory"><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / Brands</div><h1>Get to know<br/>your next bike.</h1><p class="intro">Explore the brands in our current editorial coverage, with direct paths to reviews and official stores.</p></div><div class="brand-grid section">{brands.map(b=><article class="brand-tile"><h2>{b.name}</h2><p>{b.description}</p><a class="text-link" href={`/brands/${b.slug}`}>Explore {b.name} →</a></article>)}</div></div></Layout>
