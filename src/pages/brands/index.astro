---
import Layout from '../../layouts/Layout.astro';import {brands} from '../../data/catalog';
---
<Layout title="Cycling & electric mobility brand directory"><div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / Brands</div><h1>Get to know<br/>your next bike.</h1><p class="intro">Explore our editorial brands and affiliate partners, with reader offers, buying advice and direct paths to the right storefront.</p></div><div class="brand-grid section">{brands.map(b=><article class="brand-tile"><span class="kicker">{b.platform?'Affiliate partner':'Editorial coverage'}</span><h2>{b.name}</h2><p>{b.description}</p><a class="text-link" href={`/brands/${b.slug}`}>Explore {b.name} →</a></article>)}</div></div></Layout>
