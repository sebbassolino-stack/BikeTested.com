---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import {products} from '../../data/catalog';
import {guides} from '../../data/guides';
import {giftLists} from '../../data/gift-lists.js';
export function getStaticPaths(){return giftLists.map(l=>({params:{slug:l.slug},props:{l}}))}
const {l}=Astro.props;
const picks=l.products.map(s=>products.find(p=>p.slug===s)).filter(Boolean);
const related=l.related.map(s=>guides.find(g=>g.slug===s)).filter(Boolean);
const canonical=`https://biketested.com/best/${l.slug}`;
const schema=[{'@type':'ItemList',name:l.title,itemListElement:picks.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.name,url:`https://biketested.com/reviews/${p.slug}`}))},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://biketested.com'},{'@type':'ListItem',position:2,name:'Holiday gift guide',item:'https://biketested.com/holiday-gift-guide'},{'@type':'ListItem',position:3,name:l.title,item:canonical}]}];
---
<Layout title={l.title} description={l.description} schema={schema}>
<div class="wrap"><div class="page-head"><div class="breadcrumb"><a href="/">Home</a> / <a href="/holiday-gift-guide">Holiday gift guide</a> / {l.kicker}</div><span class="kicker">{l.kicker}</span><h1>{l.title}</h1><p class="intro">{l.intro}</p></div>
<div class="answer"><span class="kicker">The quick answer</span><p>{l.answer}</p></div>
<div class="product-grid section">{picks.map(p=><ProductCard product={p}/>)}</div>
<div class="narrow prose">{l.tips.map(([h,t])=><><h2>{h}.</h2><p>{t}</p></>)}
<h2>Keep shopping.</h2><ul>{related.map(g=><li><a href={`/guides/${g.slug}`}>{g.title}</a></li>)}<li><a href="/holiday-gift-guide">Holiday gift guide</a></li><li><a href="/deals">Partner offers and codes</a></li></ul></div></div>
</Layout>
