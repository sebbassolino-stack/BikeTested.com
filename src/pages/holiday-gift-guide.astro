---
import Layout from "../layouts/Layout.astro";
import HolidayShopping from "../components/HolidayShopping.astro";
import {config,offers} from "../data/holiday-2026.js";
const edition=new Date().toLocaleDateString('en-US',{month:'long',year:'numeric',timeZone:'UTC'});
---
<Layout title={`BikeTested Holiday Gift Guide (${edition}): Cycling Gifts`} description="Choose thoughtful cycling gifts with recipient-fit guidance and useful buying guides."><HolidayShopping kind="gifts" config={config} offers={offers}/></Layout>
